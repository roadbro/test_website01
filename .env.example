# 이 파일을 .env.local로 복사한 뒤 아래 두 인증키만 입력하세요.
# 따옴표는 사용하지 않아도 됩니다.

KMA_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# 아래 값은 프로그램 기본값이 있으므로 입력하지 않아도 됩니다.
# 성남 대표지점: 기상청 성남 관측지점 AWS 572(성남시청 신청사)
# KMA_LOCATION_LAT=37.42093
# KMA_LOCATION_LON=127.12476
# KPX_REALTIME_POLL_MINUTES=15
# APP_TIMEZONE=Asia/Seoul
# MOCK_MODE=false
